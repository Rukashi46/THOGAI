# Gemini AI Configuration (Server-Side Only - Never exposed to browser)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Supabase Authentication & Cloud Database (Supported with or without VITE_ prefix)
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Remote API Backend URL for Android APK
# When running as an APK, set this to your deployed site (e.g. https://thogai.vercel.app)
# so the mobile app can reach serverless endpoints (/api/ai, /api/reconcile).
# On the web, this can be left blank (relative endpoints are used automatically).
VITE_API_URL=
